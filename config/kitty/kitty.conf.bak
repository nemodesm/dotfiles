enable_audio_bell no

font_family       FiraCode Nerd Font
bold_font         auto
italic_font       auto
bold_italic_font  auto
disable_ligatures cursor
font_features     FiraCode Nerd Font   +zero +ss01 +ss02 +ss03 +ss04 +ss05 +ss06 +ss07 +ss08 +ss09

cursor                  #d8d8d8
cursor_shape_unfocused  unchanged
cursor_shape            underline
cursor_trail            1000
wheel_scroll_multiplier 3.0
touch_scroll_multiplier 2.0

scrollbar scrolled-and-hovered

remember_window_size  no
initial_window_width  80c
initial_window_height 24c

#scrollback_pager_history_size 3

tab_bar_edge         top
tab_bar_style        slant
tab_title_max_length 25
confirm_os_window_close 2

text_fg_override_threshold 4.5 ratio
foreground #d8d8d8
background #181818
background_opacity 0.75
wayland_titlebar_color background

shell  zsh
editor vim

exe_search_path +/home/nemodesm/programs
notify_on_cmd_finish invisible 30
